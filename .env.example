# Đặt biến trong shell; file này chỉ là mẫu, Python không tự đọc .env.
export PROVIDER=openai
export MODEL=YOUR_TOOL_CALLING_MODEL
export OPENAI_API_KEY=YOUR_KEY
# export GEMINI_API_KEY=YOUR_KEY
# export ANTHROPIC_API_KEY=YOUR_KEY
# export OPENROUTER_API_KEY=YOUR_KEY
# For an OpenAI-compatible custom endpoint, use these instead or alongside the
# OpenAI settings above. API_KEY is used only when OPENAI_API_KEY is unset.
# export API_KEY=YOUR_KEY
# export API_ENDPOINT=https://your-provider.example/v1
# export API_MODEL=YOUR_TOOL_CALLING_MODEL
